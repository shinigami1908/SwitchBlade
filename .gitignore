# Build output. Globbed because -derivedDataPath is often given a suffixed
# directory, such as build-device for a signed build.
build*/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Generated by XcodeGen from project.yml — regenerate rather than commit it,
# so the two can never disagree.
*.xcodeproj/
*.xcworkspace/

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# Local signing identity. Copy Local.xcconfig.example to create it — keeping
# it untracked keeps a Team ID out of the repository, and means pulling
# changes never clobbers your own signing setup.
Local.xcconfig

# Local tool configuration — machine-specific, not part of the app
.claude/settings.local.json

# macOS
.DS_Store
